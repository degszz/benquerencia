---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sistema de gestión de portería — Estancia Benquerencia' } = Astro.props;
const base = '';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
    <title>{title} — Estancia Benquerencia</title>
  </head>
  <body class="min-h-screen bg-ben-900 text-white">

    <!-- Navbar -->
    <header class="border-b border-ben-700 bg-ben-800/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href={base} class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <img src={`${base}/logo.png`} alt="Logo" class="w-8 h-8 rounded-full" />
          <span class="font-semibold text-sm">Estancia Benquerencia</span>
        </a>
        <nav class="flex items-center gap-6 text-sm text-ben-400">
          <a href={base} class="hover:text-white transition-colors">Inicio</a>
          <a href={`${base}/porteria`} class="hover:text-white transition-colors">Portería</a>
        </nav>
      </div>
    </header>

    <!-- Contenido principal -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-ben-700 mt-20 py-8 text-center text-xs text-ben-400">
      <p>© {new Date().getFullYear()} Estancia Benquerencia · Todos los derechos reservados</p>
    </footer>

  </body>
</html>

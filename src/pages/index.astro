  <!-- CONTACTO -->
  <section id="contacto" class="relative bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8">
      <div class="text-center mb-14 reveal">
        <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">
          Contacto
        </p>
        <h2
          class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide"
        >
          Pongase en contacto con nosotros
        </h2>
        <div class="mt-6 w-12 h-px bg-roti mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 reveal">
        {
          [
            { img: "admin", label: "Administracion Comba" },

---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Benquerencia Farm Club"
  activePage="home"
  description="El club de chacras mas grande de Argentina con 2150 Ha totales, a 130 km de Capital Federal"
>
  <!-- HERO -->
  <section
    id="inicio"
    class="relative min-h-screen w-full overflow-hidden bg-forestDeep"
  >
    <div class="absolute inset-0 z-0">
      <!-- Desktop video -->
      <video
        id="hero-video-desktop"
        class="hidden md:block"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        style="object-fit:cover;width:100%;height:100%;position:absolute;top:0;left:0;"
      >
        <source src="/video/benquerencia.mp4" type="video/mp4" />
      </video>
      <!-- Mobile video -->
      <video
        id="hero-video-mobile"
        class="block md:hidden"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        style="object-fit:cover;width:100%;height:100%;position:absolute;top:0;left:0;"
      >
        <source src="/video/hero-mobile.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="absolute inset-0 z-10 bg-black/50"></div>
    <div
      class="absolute inset-x-0 top-0 h-32 z-10 bg-gradient-to-b from-forest/60 to-transparent"
    >
    </div>
    <div
      class="relative z-20 min-h-screen flex flex-col items-center justify-center px-6 md:px-8 text-center text-white"
    >
      <div class="hero-content" id="hero-text">
        <div class="uppercase text-[11px] tracking-luxe font-light text-roti">
          Estancia &middot; San Miguel del Monte &middot; Buenos Aires
        </div>
        <h1
          class="font-serif font-light text-white text-center leading-[1.05] tracking-wide text-5xl md:text-7xl lg:text-[7.5rem] md:max-w-[18ch]"
        >
          Benquerencia<br /><span
            class="italic text-center font-light text-white/95">Farm Club</span
          >
        </h1>
        <p
          class="mt-6 max-w-lg mx-auto text-[14px] md:text-base font-light leading-relaxed text-white/85"
        >
          El club de chacras mas grande de Argentina con 2150 Ha totales, 450 Ha
          de espacios comunes y 25 km de senderos. Un verdadero paraiso a 130 km
          de Capital Federal.
        </p>
      </div>
      <!-- Mini weather widget -->
    <a href="/clima" id="hero-weather" class="absolute bottom-20 md:bottom-8 right-6 md:right-8 flex items-center gap-3 px-4 py-2.5 rounded-full bg-white/[0.08] backdrop-blur-md border border-white/[0.12] text-white hover:bg-white/[0.14] hover:border-white/[0.2] transition-all duration-400 opacity-0 translate-y-3" style="transition:opacity 0.6s ease,transform 0.6s ease,background 0.3s ease,border-color 0.3s ease;">
      <div id="hw-icon" class="flex-shrink-0"></div>
      <div class="flex flex-col items-start leading-none">
        <span id="hw-temp" class="font-serif text-[22px] font-light tracking-wide">--°</span>
        <span id="hw-desc" class="text-[9px] uppercase tracking-luxe text-white/60 mt-0.5">Cargando</span>
      </div>
      <div class="hidden md:flex items-center gap-3 ml-1 pl-3 border-l border-white/[0.12]">
        <div class="flex flex-col items-start leading-none">
          <span id="hw-feels" class="text-[13px] font-light text-white/80">--°</span>
          <span class="text-[8px] uppercase tracking-luxe text-white/40">Sens.</span>
        </div>
        <div class="flex flex-col items-start leading-none">
          <span id="hw-wind" class="text-[13px] font-light text-white/80">-- km/h</span>
          <span class="text-[8px] uppercase tracking-luxe text-white/40">Viento</span>
        </div>
      </div>
    </a>

    <a
        href="#benquerencia"
        class="absolute bottom-6 left-1/2 -translate-x-1/2 scroll-arrow text-white/70 hover:text-white transition-colors"
      >
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none"
          ><polyline
            points="8,13 18,24 28,13"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></polyline></svg
        >
      </a>
    </div>
  </section>

  <!-- BENQUERENCIA teaser -->
  <section
    id="benquerencia"
    class="relative bg-white py-24 md:py-36 overflow-hidden"
  >
    <div class="max-w-3xl mx-auto px-6 md:px-8 text-center reveal">
      <div class="flex justify-center mb-12">
        <img
          src="/img/logo-barrio.png"
          alt="Benquerencia Farm Club"
          class="w-28 h-28 object-contain"
        />
      </div>
      <h2
        class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide mb-10"
      >
        Benquerencia Farm Club
      </h2>
      <p
        class="text-[16px] md:text-[19px] font-light leading-[1.85] text-slate-700 max-w-2xl mx-auto"
      >
        Es el club de chacras mas grande de Argentina con
        <span class="text-coriander font-medium">2150 Ha totales</span>,
        <span class="text-coriander font-medium">450 Ha</span> de espacios comunes,
        <span class="text-coriander font-medium">20 Ha</span> de parques del Casco
        Principal diseñado por el legendario paisajista <span class="italic"
          >Carlos Thays</span
        > y
        <span class="text-coriander font-medium">25 km</span> de senderos. Un verdadero
        paraiso a 130 km de Capital Federal.
      </p>
      <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/benquerencia"
          class="inline-flex items-center gap-2 text-[12px] uppercase tracking-luxe text-coriander hover:text-forestDeep transition-colors font-medium"
        >
          Conocer la historia
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
      <div class="mt-16 mx-auto w-16 h-px bg-roti"></div>
    </div>
  </section>

  <!-- ACTIVIDADES -->
  <style is:inline>
    .act-card { display:block; position:relative; overflow:hidden; border-radius:2px; }
    .act-img  { position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 0.8s ease,opacity 0.7s ease; }
    .act-video{ position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.7s ease;pointer-events:none; }
    .act-grad { position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.82) 0%,rgba(0,0,0,0.2) 45%,rgba(0,0,0,0.04) 100%); }
    .act-meta { position:absolute;inset-inline:0;bottom:0;padding:1.25rem;color:#fff; }
    .act-cta  { display:flex;align-items:center;gap:6px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0);margin-top:8px;transform:translateY(6px);transition:color 0.35s ease,transform 0.35s ease; }
    .act-card:hover .act-cta { color:rgba(255,255,255,0.85);transform:translateY(0); }
    /* Active card highlight bar */
    .act-bar  { position:absolute;bottom:0;left:0;height:3px;background:#C7A54E;width:0;transition:none; }
    .act-card.act-playing .act-bar { width:100%; }
  </style>
  <section id="actividades" class="relative bg-forestDeep py-20 md:py-28">
    <div class="max-w-[1400px] mx-auto px-6 md:px-8">
      <div class="text-center mb-14 reveal">
        <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">Actividades</p>
        <h2 class="font-serif font-light text-white text-4xl md:text-5xl lg:text-6xl tracking-wide">
          Naturaleza, desafios deportivos<br class="hidden md:block" /> y buenos momentos
        </h2>
        <div class="mt-8 mx-auto w-12 h-px bg-roti"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-2 md:gap-3 reveal">

        <a href="/actividades/polo" class="act-card aspect-[3/4] md:aspect-[3/5]">
          <img src="/img/actividades/polo-full.jpg" alt="Polo" class="act-img" />
          <video class="act-video" muted playsinline preload="none"><source src="/video/polo.mp4" type="video/mp4" /></video>
          <div class="act-grad"></div>
          <div class="act-meta">
            <p class="text-[9px] md:text-[10px] uppercase tracking-luxe text-roti mb-1.5">Actividades</p>
            <h3 class="font-serif font-light text-xl md:text-2xl tracking-wide leading-tight">Polo</h3>
            <p class="text-[12px] text-white/60 font-light mt-1 hidden md:block">Torneos, clases y handicap invitacional</p>
            <div class="act-cta">Ver actividad <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg></div>
          </div>
          <div class="act-bar"></div>
        </a>

        <a href="/actividades/tenis" class="act-card aspect-[3/4] md:aspect-[3/5]">
          <img src="/img/actividades/tenis-full.jpg" alt="Tenis" class="act-img" />
          <video class="act-video" muted playsinline preload="none"><source src="/video/tenis.mp4" type="video/mp4" /></video>
          <div class="act-grad"></div>
          <div class="act-meta">
            <p class="text-[9px] md:text-[10px] uppercase tracking-luxe text-roti mb-1.5">Actividades</p>
            <h3 class="font-serif font-light text-xl md:text-2xl tracking-wide leading-tight">Tenis</h3>
            <p class="text-[12px] text-white/60 font-light mt-1 hidden md:block">2 canchas sinteticas en el casco</p>
            <div class="act-cta">Ver actividad <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg></div>
          </div>
          <div class="act-bar"></div>
        </a>

        <a href="/actividades/golf" class="act-card aspect-[3/4] md:aspect-[3/5]">
          <img src="/img/actividades/golf-full.jpg" alt="Golf" class="act-img" />
          <video class="act-video" muted playsinline preload="none"><source src="/video/golf.mp4" type="video/mp4" /></video>
          <div class="act-grad"></div>
          <div class="act-meta">
            <p class="text-[9px] md:text-[10px] uppercase tracking-luxe text-roti mb-1.5">Actividades</p>
            <h3 class="font-serif font-light text-xl md:text-2xl tracking-wide leading-tight">Golf</h3>
            <p class="text-[12px] text-white/60 font-light mt-1 hidden md:block">9 hoyos · Diseno Gary Player Group</p>
            <div class="act-cta">Ver actividad <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg></div>
          </div>
          <div class="act-bar"></div>
        </a>

        <a href="/actividades/caballos" class="act-card aspect-[3/4] md:aspect-[3/5]">
          <img src="/img/actividades/caballos-full.jpg" alt="Caballos" class="act-img" />
          <video class="act-video" muted playsinline preload="none"><source src="/video/caballos.mp4" type="video/mp4" /></video>
          <div class="act-grad"></div>
          <div class="act-meta">
            <p class="text-[9px] md:text-[10px] uppercase tracking-luxe text-roti mb-1.5">Actividades</p>
            <h3 class="font-serif font-light text-xl md:text-2xl tracking-wide leading-tight">Caballos</h3>
            <p class="text-[12px] text-white/60 font-light mt-1 hidden md:block">25 km de senderos arbolados</p>
            <div class="act-cta">Ver actividad <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg></div>
          </div>
          <div class="act-bar"></div>
        </a>

        <a href="/actividades/futbol" class="act-card col-span-2 md:col-span-1 aspect-[8/5] md:aspect-[3/5]">
          <img src="/img/actividades/futbol-full.jpg" alt="Futbol" class="act-img" />
          <video class="act-video" muted playsinline preload="none"><source src="/video/polo.mp4" type="video/mp4" /></video>
          <div class="act-grad"></div>
          <div class="act-meta">
            <p class="text-[9px] md:text-[10px] uppercase tracking-luxe text-roti mb-1.5">Actividades</p>
            <h3 class="font-serif font-light text-xl md:text-2xl tracking-wide leading-tight">Futbol</h3>
            <p class="text-[12px] text-white/60 font-light mt-1 hidden md:block">Cancha en el casco de la estancia</p>
            <div class="act-cta">Ver actividad <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg></div>
          </div>
          <div class="act-bar"></div>
        </a>

      </div>
    </div>

    <script is:inline>
    (function(){
      var cards = document.querySelectorAll('.act-card');
      var current = 0;
      var DURATION = 6000; // 6s per card
      var timer = null;
      var paused = false;
      var hasVideo = true;

      function activate(idx) {
        cards.forEach(function(card, i) {
          var video = card.querySelector('.act-video');
          var img = card.querySelector('.act-img');
          var bar = card.querySelector('.act-bar');
          if (i === idx) {
            card.classList.add('act-playing');
            // Animate progress bar
            bar.style.transition = 'none';
            bar.style.width = '0%';
            // Force reflow
            void bar.offsetWidth;
            bar.style.transition = 'width ' + (DURATION / 1000) + 's linear';
            bar.style.width = '100%';
            if (hasVideo && video) {
              video.style.opacity = '1';
              img.style.opacity = '0';
              img.style.transform = 'scale(1.06)';
              video.currentTime = 0;
              video.play().catch(function(){});
            }
          } else {
            card.classList.remove('act-playing');
            bar.style.transition = 'none';
            bar.style.width = '0%';
            if (hasVideo && video) {
              video.style.opacity = '0';
              img.style.opacity = '1';
              img.style.transform = 'scale(1)';
              video.pause();
            }
          }
        });
      }

      function next() {
        current = (current + 1) % cards.length;
        activate(current);
      }

      function startCycle() {
        if (timer) clearInterval(timer);
        activate(current);
        timer = setInterval(next, DURATION);
      }

      // Pause cycling on hover, show hovered card
      cards.forEach(function(card, i) {
        card.addEventListener('mouseenter', function() {
          paused = true;
          if (timer) clearInterval(timer);
          current = i;
          activate(i);
          // Freeze the bar at full
          var bar = card.querySelector('.act-bar');
          bar.style.transition = 'width 0.3s ease';
          bar.style.width = '100%';
        });
        card.addEventListener('mouseleave', function() {
          paused = false;
          startCycle();
        });
      });

      // Start when section is visible (IntersectionObserver)
      var section = document.getElementById('actividades');
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting && !timer) {
              startCycle();
            } else if (!entry.isIntersecting && timer && !paused) {
              clearInterval(timer);
              timer = null;
              // Pause all videos when out of view
              cards.forEach(function(card) {
                var v = card.querySelector('.act-video');
                if (v) v.pause();
              });
            }
          });
        }, { threshold: 0.2 });
        obs.observe(section);
      } else {
        startCycle();
      }
    })();
    </script>
  </section>

  <!-- SERVICIOS teaser -->
  <section id="servicios" class="relative bg-white py-24 md:py-32">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8">
      <div class="text-center mb-16 reveal">
        <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">
          Servicios
        </p>
        <h2
          class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide"
        >
          Servicios
        </h2>
        <div class="mt-6 w-12 h-px bg-roti mx-auto"></div>
        <p
          class="mt-8 max-w-2xl mx-auto text-[15px] font-light leading-relaxed text-slate-600"
        >
          Las instalaciones originales de Benquerencia fueron especialmente
          restauradas y acondicionadas para brindar servicio de alojamiento y
          gastronomia tanto a propietarios como a invitados.
        </p>
      </div>
      <div id="home-svc-grid" class="grid grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6 reveal mb-6">
        {
          [
            { icon: "gastronomia", label: "Gastronomia", desc: "Carnes a la parrilla y platos caseros en La Matera. La Casa Principal para eventos especiales con vistas al parque historico." },
            { icon: "capilla", label: "Capilla", desc: "Punto de reunion de la comunidad catolica del barrio, en un edificio historico restaurado con mucho caracter." },
            { icon: "spa", label: "Spa", desc: "Masajes, manicuria y estetica en la Casa de la Torre. Turnos flexibles para sesiones individuales." },
            { icon: "alojamiento", label: "Alojamiento", desc: "Casa Principal, Posada y La Matera ofrecen habitaciones con bano privado en el casco historico del club." },
            { icon: "eventos", label: "Eventos", desc: "Espacios unicos para celebraciones privadas y eventos al aire libre en los jardines diseñados por Carlos Thays." },
            { icon: "plaza", label: "Plaza de Juegos", desc: "Espacios recreativos para los mas chicos dentro de los parques del casco principal, seguros y al aire libre." },
            { icon: "proveedores", label: "Proveedores", desc: "Red de proveedores locales especializados: jardineria, construccion, electricidad y mantenimiento de chacras." },
            { icon: "delivery", label: "Delivery", desc: "Servicio de delivery interno para propietarios e invitados. Productos de la despensa directamente a su chacra." },
            { icon: "inmobiliarias", label: "Inmobiliarias", desc: "Asesores inmobiliarios especializados en la compra y venta de chacras en Benquerencia Farm Club." },
          ].map((s) => (
            <button class="home-svc-btn flex flex-col items-center text-center p-5 md:p-6 rounded-sm bg-cream/40 w-full transition-all duration-300 border-2 border-transparent hover:border-roti/40" data-id={s.icon} data-label={s.label} data-desc={s.desc}>
              <img
                src={`/img/icons/${s.icon}.png`}
                alt={s.label}
                class="w-12 h-12 md:w-14 md:h-14 object-contain mb-4"
              />
              <span class="text-[13px] md:text-[15px] font-light tracking-wide text-slate-700">
                {s.label}
              </span>
              <div class="home-svc-dot w-1.5 h-1.5 rounded-full bg-coriander opacity-0 mt-2 transition-all duration-300"></div>
            </button>
          ))
        }
      </div>
      <!-- Summary strip -->
      <div id="home-svc-panel" class="mb-10 overflow-hidden transition-all duration-500" style="max-height:0;opacity:0;">
        <div class="bg-cream/60 rounded-xl border border-roti/15 px-6 md:px-8 py-5 flex items-start gap-5">
          <img id="home-svc-icon" src="" alt="" class="w-10 h-10 object-contain flex-shrink-0 mt-0.5" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-4">
              <p class="uppercase text-[11px] tracking-luxe text-coriander font-medium" id="home-svc-title"></p>
              <button id="home-svc-close" class="text-slate-400 hover:text-slate-600 transition-colors flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <p class="mt-1.5 text-[14px] leading-relaxed text-slate-600 font-light" id="home-svc-desc"></p>
            <a href="/servicios" class="inline-flex items-center gap-1.5 mt-3 text-[11px] uppercase tracking-luxe text-coriander hover:text-forestDeep transition-colors font-medium">
              Ver detalles completos
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div class="text-center reveal">
        <a
          href="/servicios"
          class="inline-flex items-center gap-2 text-[12px] uppercase tracking-luxe text-coriander hover:text-forestDeep transition-colors font-medium"
        >
          Ver todos los servicios
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
      <script is:inline>
      (function(){
        var activeId = null;
        var panel = document.getElementById('home-svc-panel');
        var titleEl = document.getElementById('home-svc-title');
        var descEl = document.getElementById('home-svc-desc');
        var iconEl = document.getElementById('home-svc-icon');

        function openPanel(id, label, desc) {
          activeId = id;
          titleEl.textContent = label;
          descEl.textContent = desc;
          iconEl.src = '/img/icons/' + id + '.png';
          iconEl.alt = label;
          panel.style.maxHeight = '300px';
          panel.style.opacity = '1';
        }
        function closePanel() {
          activeId = null;
          panel.style.maxHeight = '0';
          panel.style.opacity = '0';
          document.querySelectorAll('.home-svc-btn').forEach(function(b) {
            b.classList.remove('active');
            b.style.borderColor = '';
            b.style.background = '';
            b.querySelector('.home-svc-dot').style.opacity = '0';
          });
        }

        document.getElementById('home-svc-close').addEventListener('click', closePanel);

        document.querySelectorAll('.home-svc-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var id = this.getAttribute('data-id');
            if (activeId === id) { closePanel(); return; }
            // Reset all
            document.querySelectorAll('.home-svc-btn').forEach(function(b) {
              b.style.borderColor = '';
              b.style.background = '';
              b.querySelector('.home-svc-dot').style.opacity = '0';
            });
            // Activate this
            this.style.borderColor = '#488A0F';
            this.style.background = 'rgba(72,138,15,0.05)';
            this.querySelector('.home-svc-dot').style.opacity = '1';
            openPanel(id, this.getAttribute('data-label'), this.getAttribute('data-desc'));
          });
        });
      })();
      </script>
    </div>
  </section>

  <!-- CLIMA teaser -->
  <section id="clima" class="relative bg-cream/30 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-6 md:px-8">
      <div class="text-center mb-12 reveal">
        <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">Clima</p>
        <h2 class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide">
          El tiempo en Benquerencia
        </h2>
        <div class="mt-6 w-12 h-px bg-roti mx-auto"></div>
      </div>
      <div id="clima-cards" class="grid grid-cols-4 md:grid-cols-7 gap-2 md:gap-3 reveal">
        <!-- Skeleton -->
        <div class="bg-white/60 rounded-xl h-28 animate-pulse"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse hidden md:block"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse hidden md:block"></div>
        <div class="bg-white/60 rounded-xl h-28 animate-pulse hidden md:block"></div>
      </div>
      <!-- Day summary panel -->
      <div id="clima-summary" class="mt-4 reveal" style="display:none;">
        <div class="bg-white rounded-xl p-5 md:p-6 shadow-sm transition-all duration-300">
          <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
            <div id="cs-icon" class="flex-shrink-0"></div>
            <div class="flex-1 text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start gap-3 mb-1">
                <h3 id="cs-day" class="font-serif font-light text-slate-800 text-xl md:text-2xl tracking-wide">Hoy</h3>
                <span id="cs-condition" class="text-[12px] text-slate-500 font-light"></span>
              </div>
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-5 gap-y-2 mt-3">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-roti" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v1m0 16v1m-8-9H3m18 0h-1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707" stroke-linecap="round"/><circle cx="12" cy="12" r="4"/></svg>
                  <span class="text-[13px] text-slate-700"><span id="cs-max" class="font-medium"></span> / <span id="cs-min" class="text-slate-400"></span></span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-coriander" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span id="cs-rain" class="text-[13px] text-slate-700"></span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                  <span id="cs-wind" class="text-[13px] text-slate-700"></span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span id="cs-precip" class="text-[13px] text-slate-700"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="text-center mt-10 reveal">
        <a href="/clima" class="inline-flex items-center gap-2 text-[12px] uppercase tracking-luxe text-coriander hover:text-forestDeep transition-colors font-medium">
          Ver pronostico completo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
    <script is:inline>
    (function(){
      var LAT=-35.4397,LON=-58.7062;
      var DAYS=['Dom','Lun','Mar','Mie','Jue','Vie','Sab'];

      function dayIcon(code,sz,night){
        var s=sz||36;var inner='';
        var moonSvg='<path d="M13.5 3.5A7.5 7.5 0 1 0 13.5 19 5.5 5.5 0 1 1 13.5 3.5z" fill="#C7A54E"/>';
        var starsSvg='<circle cx="5" cy="6" r="0.7" fill="#C7A54E" opacity="0.7"/><circle cx="3.5" cy="12" r="0.5" fill="#C7A54E" opacity="0.5"/><circle cx="7" cy="3.5" r="0.5" fill="#C7A54E" opacity="0.6"/>';
        if(code<=1){
          if(night){inner=moonSvg+starsSvg;}
          else{inner='<circle cx="12" cy="12" r="4.5" fill="#C7A54E"/><g stroke="#C7A54E" stroke-width="1.5" stroke-linecap="round"><line x1="12" y1="1.5" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22.5"/><line x1="1.5" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22.5" y2="12"/><line x1="4.2" y1="4.2" x2="6" y2="6"/><line x1="18" y1="18" x2="19.8" y2="19.8"/><line x1="4.2" y1="19.8" x2="6" y2="18"/><line x1="18" y1="6" x2="19.8" y2="4.2"/></g>';}
        }else if(code===2){
          if(night){inner='<path d="M11 3A5.5 5.5 0 1 0 11 14 4 4 0 1 1 11 3z" fill="#C7A54E"/><path d="M7 20h11c2.5 0 4-1.8 3.5-4.2a4.8 4.8 0 0 0-4.2-3.6 5.5 5.5 0 0 0-9.8 3A3.5 3.5 0 0 0 7 20z" fill="#94a3b8" opacity="0.6"/>';}
          else{inner='<circle cx="9" cy="8" r="3" fill="#C7A54E"/><g stroke="#C7A54E" stroke-width="1.2" stroke-linecap="round"><line x1="9" y1="2" x2="9" y2="3.8"/><line x1="9" y1="12.2" x2="9" y2="14"/><line x1="3" y1="8" x2="4.8" y2="8"/><line x1="13.2" y1="8" x2="15" y2="8"/><line x1="4.8" y1="3.8" x2="6.2" y2="5.2"/><line x1="11.8" y1="10.8" x2="13.2" y2="12.2"/></g><path d="M7 20h11c2.5 0 4-1.8 3.5-4.2a4.8 4.8 0 0 0-4.2-3.6 5.5 5.5 0 0 0-9.8 3A3.5 3.5 0 0 0 7 20z" fill="#94a3b8" opacity="0.6"/>';}
        }else if(code===3){
          inner='<path d="M5 17h14c2.8 0 4.5-2 4-4.8a5.2 5.2 0 0 0-4.8-3.8 6.5 6.5 0 0 0-11.7 3.2A4 4 0 0 0 5 17z" fill="#94a3b8" opacity="0.7"/><path d="M8 13.5h9c2 0 3.2-1.4 2.8-3.2a3.8 3.8 0 0 0-3.5-2.8A4.5 4.5 0 0 0 8 9.8a2.8 2.8 0 0 0 0 3.7z" fill="#64748b" opacity="0.5"/>';
        }else if(code>=45&&code<=48){
          inner='<line x1="3" y1="9" x2="21" y2="9" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="13" x2="19" y2="13" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/><line x1="7" y1="17" x2="17" y2="17" stroke="#94a3b8" stroke-width="2" stroke-linecap="round"/>';
        }else if(code>=51&&code<=55){
          inner='<path d="M6 14h12c2.5 0 4-1.8 3.5-4.2a4.5 4.5 0 0 0-4-3.5 5.5 5.5 0 0 0-9.5 2.5A3.5 3.5 0 0 0 6 14z" fill="#94a3b8" opacity="0.7"/><line x1="9.5" y1="16.5" x2="8.5" y2="20.5" stroke="#488A0F" stroke-width="1.3" stroke-linecap="round"/><line x1="14.5" y1="16.5" x2="13.5" y2="20.5" stroke="#488A0F" stroke-width="1.3" stroke-linecap="round"/>';
        }else if((code>=61&&code<=65)||(code>=80&&code<=82)){
          inner='<path d="M5 13h14c2.8 0 4.5-2 4-4.8a5 5 0 0 0-4.5-3.5 6 6 0 0 0-11 3A3.8 3.8 0 0 0 5 13z" fill="#64748b" opacity="0.75"/><line x1="8" y1="16" x2="7" y2="20.5" stroke="#488A0F" stroke-width="1.4" stroke-linecap="round"/><line x1="12" y1="16" x2="11" y2="21" stroke="#488A0F" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="16" x2="15" y2="20" stroke="#488A0F" stroke-width="1.4" stroke-linecap="round"/>';
        }else if(code>=71&&code<=75){
          inner='<path d="M5 13h14c2.8 0 4.5-2 4-4.8a5 5 0 0 0-4.5-3.5 6 6 0 0 0-11 3A3.8 3.8 0 0 0 5 13z" fill="#94a3b8" opacity="0.7"/><circle cx="8.5" cy="18" r="1.3" fill="#64748b" opacity="0.7"/><circle cx="12.5" cy="20" r="1.3" fill="#64748b" opacity="0.7"/><circle cx="16" cy="17" r="1.3" fill="#64748b" opacity="0.7"/>';
        }else if(code>=95){
          inner='<path d="M5 12h14c2.8 0 4.5-2 4-4.8a5 5 0 0 0-4.5-3.5 6 6 0 0 0-11 3A3.8 3.8 0 0 0 5 12z" fill="#64748b" opacity="0.8"/><path d="M13 14l-2.2 4.5h4l-2.2 4.5" stroke="#C7A54E" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>';
        }else{
          inner=night?moonSvg+starsSvg:'<circle cx="12" cy="12" r="4.5" fill="#C7A54E"/>';
        }
        return '<svg width="'+s+'" height="'+s+'" viewBox="0 0 24 24" fill="none">'+inner+'</svg>';
      }

      var WMO={0:'Despejado',1:'Mayormente despejado',2:'Parcialmente nublado',3:'Nublado',
        45:'Neblina',48:'Neblina helada',51:'Llovizna leve',53:'Llovizna',55:'Llovizna intensa',
        61:'Lluvia leve',63:'Lluvia moderada',65:'Lluvia intensa',71:'Nieve leve',73:'Nieve',75:'Nieve intensa',
        80:'Chubascos leves',81:'Chubascos',82:'Chubascos intensos',95:'Tormenta',96:'Tormenta con granizo',99:'Tormenta fuerte'};

      function showSummary(i,d){
        var dt=new Date(d.time[i]+'T12:00:00');
        var label=i===0?'Hoy':i===1?'Mañana':DAYS[dt.getDay()]+' '+dt.getDate();
        // Show moon for "Hoy" if it's currently after sunset or before sunrise
        var isNight=false;
        if(i===0 && d.sunrise && d.sunset){
          var nowH=new Date().getHours();
          var srH=parseInt(d.sunrise[0].split('T')[1].split(':')[0]);
          var ssH=parseInt(d.sunset[0].split('T')[1].split(':')[0]);
          isNight=nowH<srH||nowH>=ssH;
        }
        document.getElementById('cs-day').textContent=label;
        document.getElementById('cs-condition').textContent=WMO[d.weather_code[i]]||'';
        document.getElementById('cs-icon').innerHTML=dayIcon(d.weather_code[i],48,isNight);
        document.getElementById('cs-max').textContent=Math.round(d.temperature_2m_max[i])+'°';
        document.getElementById('cs-min').textContent=Math.round(d.temperature_2m_min[i])+'°';
        document.getElementById('cs-rain').textContent=(d.precipitation_probability_max[i]||0)+'% prob. lluvia';
        document.getElementById('cs-wind').textContent=Math.round(d.wind_speed_10m_max[i])+' km/h';
        document.getElementById('cs-precip').textContent=Math.round(d.precipitation_sum[i]*10)/10+' mm acum.';
        document.getElementById('clima-summary').style.display='';
        // highlight active card
        document.querySelectorAll('#clima-cards > div').forEach(function(c,idx){
          if(idx===i){c.style.borderColor='#488A0F';c.style.background='rgba(72,138,15,0.05)';c.style.boxShadow='0 4px 20px -6px rgba(72,138,15,0.3)';}
          else{c.style.borderColor='transparent';c.style.background='';c.style.boxShadow='';}
        });
      }

      fetch('https://api.open-meteo.com/v1/forecast?latitude='+LAT+'&longitude='+LON+
        '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,wind_speed_10m_max,sunrise,sunset'+
        '&timezone=America/Argentina/Buenos_Aires&forecast_days=7')
        .then(function(r){return r.json();})
        .then(function(data){
          var d=data.daily,html='';
          for(var i=0;i<d.time.length;i++){
            var dt=new Date(d.time[i]+'T12:00:00');
            var dayName=i===0?'Hoy':i===1?'Mañana':DAYS[dt.getDay()];
            var prob=d.precipitation_probability_max[i]||0;
            html+='<div data-day="'+i+'" class="bg-white rounded-xl p-3 md:p-4 text-center shadow-sm hover:shadow-md transition-all cursor-pointer'+(i>=4?' hidden md:block':'')+'" style="border:2px solid transparent;">';
            html+='<div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;font-weight:500;color:#64748b;margin-bottom:8px">'+dayName+'</div>';
            html+='<div style="display:flex;justify-content:center;margin-bottom:8px">'+dayIcon(d.weather_code[i],38)+'</div>';
            html+='<div style="font-family:\'Cormorant Garamond\',serif;font-size:20px;font-weight:300;color:#1e293b;line-height:1.1">'+Math.round(d.temperature_2m_max[i])+'°</div>';
            html+='<div style="font-family:\'Cormorant Garamond\',serif;font-size:15px;font-weight:300;color:#94a3b8">'+Math.round(d.temperature_2m_min[i])+'°</div>';
            if(prob>20){html+='<div style="font-size:10px;color:#488A0F;margin-top:6px;font-weight:500">'+prob+'%<span style="color:#94a3b8;font-weight:300"> lluvia</span></div>';}
            html+='</div>';
          }
          document.getElementById('clima-cards').innerHTML=html;

          // Show today by default
          showSummary(0,d);

          // Click handlers
          document.querySelectorAll('#clima-cards > div').forEach(function(card){
            card.addEventListener('click',function(){
              var idx=parseInt(this.getAttribute('data-day'));
              showSummary(idx,d);
            });
          });
        }).catch(function(){});
    })();
    </script>
  </section>


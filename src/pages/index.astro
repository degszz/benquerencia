<script>
  // ── Referencias DOM ──
  const siteHeader = document.getElementById('site-header');
  const ownerBar   = document.getElementById('owner-bar');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuToggle = document.getElementById('menu-toggle');
  const iconOpen   = document.getElementById('menu-icon-open');
  const iconClose  = document.getElementById('menu-icon-close');

  // ── Cerrar menú mobile ──
  function closeMenu() {
    mobileMenu?.classList.remove('open');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  // ── Header: transparente en hero, con fondo al scrollear ──
  // Al volver al top también se cierra el menú (evita menú abierto con bg transparente)
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 80;
    siteHeader?.classList.toggle('header-scrolled', scrolled);
    ownerBar?.classList.toggle('hidden', scrolled);
    if (!scrolled) closeMenu();
  }, { passive: true });

  // ── Mobile menu toggle ──
  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('open');
    iconOpen?.classList.toggle('hidden', !!isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  // Cerrar al hacer clic en un link del menú
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // ── Hero text timing: sincronizado con video.currentTime ──
  const heroText  = document.getElementById('hero-text');
  const heroVideo = document.querySelector('#inicio video');
  const SHOW_AT   = 9;   // aparece en el segundo 9
  const HIDE_AT   = 127; // desaparece en 2:07

  const pageStart = Date.now();
  function tickHeroText() {
    let t;
    if (heroVideo && heroVideo.readyState >= 2 && !heroVideo.paused) {
      t = heroVideo.currentTime;
    } else {
      t = (Date.now() - pageStart) / 1000;
    }
    const visible = t >= SHOW_AT && t < HIDE_AT;
    heroText?.classList.toggle('show', visible);
    heroText?.classList.toggle('hide', !visible);
    requestAnimationFrame(tickHeroText);
  }
  tickHeroText();

  // ── Reveal on scroll ──
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>


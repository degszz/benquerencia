---
import '../styles/globals.css';
const base = '';
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Estancia Benquerencia Farm Club — Exclusivo barrio de chacras en San Miguel del Monte, Buenos Aires" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
    <title>Estancia Benquerencia Farm Club</title>
    <style>
      /* Animations */
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes scaleIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
      }
      @keyframes slideLeft {
        from { opacity: 0; transform: translateX(60px); }
        to { opacity: 1; transform: translateX(0); }
      }
      @keyframes slideRight {
        from { opacity: 0; transform: translateX(-60px); }
        to { opacity: 1; transform: translateX(0); }
      }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }
      .fade-up { opacity: 0; animation: fadeUp 0.8s ease-out forwards; }
      .fade-in { opacity: 0; animation: fadeIn 1s ease-out forwards; }
      .scale-in { opacity: 0; animation: scaleIn 0.8s ease-out forwards; }
      .slide-left { opacity: 0; animation: slideLeft 0.8s ease-out forwards; }
      .slide-right { opacity: 0; animation: slideRight 0.8s ease-out forwards; }
      .delay-1 { animation-delay: 0.15s; }
      .delay-2 { animation-delay: 0.3s; }
      .delay-3 { animation-delay: 0.45s; }
      .delay-4 { animation-delay: 0.6s; }
      .delay-5 { animation-delay: 0.75s; }
      .delay-6 { animation-delay: 0.9s; }
      .floating { animation: float 6s ease-in-out infinite; }

      /* Scroll-triggered animations */
      .reveal { opacity: 0; transform: translateY(30px); transition: all 0.7s ease-out; }
      .reveal.visible { opacity: 1; transform: translateY(0); }

      /* Fonts */
      .font-display { font-family: 'Playfair Display', serif; }
      .font-body { font-family: 'Inter', sans-serif; }

      /* Hero gradient overlay */
      .hero-gradient {
        background: linear-gradient(
          180deg,
          rgba(15, 26, 15, 0.3) 0%,
          rgba(15, 26, 15, 0.6) 40%,
          rgba(15, 26, 15, 0.95) 85%,
          #0f1a0f 100%
        );
      }

      /* Image hover effect */
      .img-hover { transition: transform 0.6s ease, filter 0.6s ease; }
      .img-hover:hover { transform: scale(1.05); filter: brightness(1.1); }

      /* Gold accent */
      .text-gold { color: #c4a265; }
      .border-gold { border-color: #c4a26540; }
      .bg-gold { background-color: #c4a265; }

      /* Elegant divider */
      .divider {
        width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c4a265, transparent);
      }

      /* Parallax-like fixed background */
      .bg-fixed {
        background-attachment: fixed;
        background-size: cover;
        background-position: center;
      }

      /* Hero slideshow */
      .hero-slide {
        position: absolute; inset: 0;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
      }
      .hero-slide.active { opacity: 1; }
      .hero-slide img {
        width: 100%; height: 100%;
        object-fit: cover;
      }

      /* CTA pulse */
      @keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(74, 122, 74, 0.4); }
        50% { box-shadow: 0 0 20px 8px rgba(74, 122, 74, 0.2); }
      }
      .pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }

      /* Header */
      .site-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        padding: 1.25rem 0;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .site-header.scrolled {
        padding: 0.75rem 0;
        background: rgba(15, 26, 15, 0.85);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        border-bottom: none;
      }
      .header-logo {
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      .site-header.scrolled .header-logo {
        opacity: 1;
        transform: translateY(0);
      }

      /* Mobile menu */
      .mobile-menu {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, opacity 0.2s ease;
      }
      .mobile-menu.open {
        max-height: 300px;
        opacity: 1;
      }

      /* Numbers counter animation */
      .stat-number {
        font-variant-numeric: tabular-nums;
      }
    </style>
  </head>
  <body class="bg-[#0f1a0f] text-white font-body overflow-x-hidden">

    <!-- ═══════════════════════════════════════════════════════════════
         HEADER — Transparente, aparece con fondo al scrollear
         ═══════════════════════════════════════════════════════════════ -->
    <header class="site-header" id="site-header">
      <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
        <!-- Logo (aparece al scrollear) -->
        <a href="/" class="header-logo flex items-center gap-3">
          <img src="/img/logo-benquerencia-verde.png" alt="Logo" class="w-8 h-8 rounded-full" />
          <span class="font-display text-sm font-semibold hidden sm:inline">Benquerencia</span>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden md:flex items-center gap-8 text-[13px] text-white/50 uppercase tracking-widest">
          <a href="#amenities" class="hover:text-white transition-colors">Actividades</a>
          <a href="#ubicacion" class="hover:text-white transition-colors">Ubicación</a>
          <a href="#contacto" class="hover:text-white transition-colors">Contacto</a>
        </nav>

        <!-- Hamburger mobile -->
        <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-white/60 hover:text-white transition-colors" aria-label="Menu">
          <svg class="w-5 h-5" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-5 h-5 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div class="mobile-menu md:hidden" id="mobile-menu">
        <nav class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-4 text-[13px] text-white/60 uppercase tracking-widest">
          <a href="#amenities" class="hover:text-white transition-colors py-1">Actividades</a>
          <a href="#ubicacion" class="hover:text-white transition-colors py-1">Ubicación</a>
          <a href="#contacto" class="hover:text-white transition-colors py-1">Contacto</a>
        </nav>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         HERO — Full viewport with background image
         ═══════════════════════════════════════════════════════════════ -->
    <section class="relative min-h-screen flex items-center justify-center">
      <!-- Background slideshow -->
      <div class="absolute inset-0">
        <div class="hero-slide active" data-slide="0">
          <img src="/img/hero-1.jpg" alt="Estancia Benquerencia" />
        </div>
        <div class="hero-slide" data-slide="1">
          <img src="/img/hero-2.jpg" alt="Laguna Benquerencia" />
        </div>
        <div class="hero-slide" data-slide="2">
          <img src="/img/hero-3.jpg" alt="Paisaje Benquerencia" />
        </div>
        <div class="hero-gradient absolute inset-0"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
        <img
          src={`${base}/img/logo-benquerencia-verde.png`}
          alt="Logo Benquerencia"
          class="w-24 h-24 md:w-32 md:h-32 mx-auto mb-8 fade-in floating"
        />
        <p class="text-gold uppercase tracking-[0.3em] text-xs md:text-sm font-medium fade-up delay-1">
          San Miguel del Monte · Buenos Aires
        </p>
        <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold mt-4 mb-6 fade-up delay-2 leading-tight">
          Estancia<br/>Benquerencia
        </h1>
        <p class="text-lg md:text-xl text-white/70 max-w-xl mx-auto fade-up delay-3">
          Farm Club · Exclusivo barrio de chacras desde 1998
        </p>

        <div class="divider mx-auto mt-8 mb-8 fade-in delay-4"></div>

        <!-- Scroll indicator -->
        <div class="fade-in delay-5">
          <a href="#amenities" class="inline-flex flex-col items-center gap-2 text-white/40 hover:text-white/70 transition-colors">
            <span class="text-xs tracking-widest uppercase">Descubrí</span>
            <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         AMENITIES — 4 actividades con secciones expandibles + video
         ═══════════════════════════════════════════════════════════════ -->
    <section id="amenities" class="py-20 md:py-32 bg-[#0f1a0f]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 reveal">
          <p class="text-gold uppercase tracking-[0.25em] text-xs font-medium mb-3">Nuestras Amenities</p>
          <h2 class="font-display text-3xl md:text-5xl font-bold">Un estilo de vida único</h2>
          <div class="divider mx-auto mt-6"></div>
        </div>

        <!-- Grid 2x2 siempre (incluso en mobile) -->
        <div class="grid grid-cols-2 gap-3 sm:gap-6 md:gap-8">
          <!-- Polo -->
          <a href="/polo" class="group relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[4/3] reveal block">
            <img src="/img/polo-home.jpg" alt="Polo" class="w-full h-full object-cover img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-6 md:p-8">
              <h3 class="font-display text-lg sm:text-2xl md:text-3xl font-bold mb-0.5 sm:mb-2">Polo</h3>
              <p class="text-white/60 text-[11px] sm:text-sm md:text-base hidden sm:block">Canchas profesionales para la práctica del deporte rey</p>
              <span class="inline-flex items-center gap-1 sm:gap-1.5 mt-1.5 sm:mt-3 text-gold text-[10px] sm:text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                Ver más
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- Tenis -->
          <a href="/tenis" class="group relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[4/3] reveal block">
            <img src="/img/tenis-new.jpg" alt="Tenis" class="w-full h-full object-cover img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-6 md:p-8">
              <h3 class="font-display text-lg sm:text-2xl md:text-3xl font-bold mb-0.5 sm:mb-2">Tenis</h3>
              <p class="text-white/60 text-[11px] sm:text-sm md:text-base hidden sm:block">Canchas iluminadas rodeadas de naturaleza</p>
              <span class="inline-flex items-center gap-1 sm:gap-1.5 mt-1.5 sm:mt-3 text-gold text-[10px] sm:text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                Ver más
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- Golf -->
          <a href="/golf" class="group relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[4/3] reveal block">
            <img src="/img/golf-new.jpg" alt="Golf" class="w-full h-full object-cover img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-6 md:p-8">
              <h3 class="font-display text-lg sm:text-2xl md:text-3xl font-bold mb-0.5 sm:mb-2">Golf</h3>
              <p class="text-white/60 text-[11px] sm:text-sm md:text-base hidden sm:block">Campo de golf con vistas a la pampa argentina</p>
              <span class="inline-flex items-center gap-1 sm:gap-1.5 mt-1.5 sm:mt-3 text-gold text-[10px] sm:text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                Ver más
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- Equitación -->
          <a href="/equitacion" class="group relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[4/3] reveal block">
            <img src="/img/equitacion-new.jpg" alt="Equitación" class="w-full h-full object-cover img-hover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-6 md:p-8">
              <h3 class="font-display text-lg sm:text-2xl md:text-3xl font-bold mb-0.5 sm:mb-2">Equitación</h3>
              <p class="text-white/60 text-[11px] sm:text-sm md:text-base hidden sm:block">Caballerizas y paseos por la estancia</p>
              <span class="inline-flex items-center gap-1 sm:gap-1.5 mt-1.5 sm:mt-3 text-gold text-[10px] sm:text-xs uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                Ver más
                <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         NÚMEROS — Stats del barrio
         ═══════════════════════════════════════════════════════════════ -->
    <section class="py-16 md:py-20 border-t border-b border-white/5">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center reveal">
          <div>
            <p class="font-display text-4xl md:text-5xl font-bold text-gold stat-number">1998</p>
            <p class="text-xs md:text-sm text-white/40 mt-2 uppercase tracking-wider">Fundación</p>
          </div>
          <div>
            <p class="font-display text-4xl md:text-5xl font-bold text-white stat-number">120</p>
            <p class="text-xs md:text-sm text-white/40 mt-2 uppercase tracking-wider">Hectáreas</p>
          </div>
          <div>
            <p class="font-display text-4xl md:text-5xl font-bold text-white stat-number">6</p>
            <p class="text-xs md:text-sm text-white/40 mt-2 uppercase tracking-wider">Deportes</p>
          </div>
          <div>
            <p class="font-display text-4xl md:text-5xl font-bold text-white stat-number">110</p>
            <p class="text-xs md:text-sm text-white/40 mt-2 uppercase tracking-wider">km de Buenos Aires</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SOBRE BENQUERENCIA — Quote / About
         ═══════════════════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28">
      <div class="max-w-4xl mx-auto px-6 text-center reveal">
        <div class="divider mx-auto mb-8"></div>
        <blockquote class="font-display text-2xl md:text-4xl font-medium leading-relaxed text-white/90">
          "Un lugar donde el tiempo se mide en atardeceres y la vida transcurre al ritmo del campo"
        </blockquote>
        <p class="mt-6 text-white/50 text-base md:text-lg max-w-2xl mx-auto">
          Estancia Benquerencia Farm Club se desarrolló en 1998 como un exclusivo barrio de chacras.
          Ubicado en San Miguel del Monte, Provincia de Buenos Aires, ofrecemos un estilo de vida
          donde la tranquilidad del campo se combina con las comodidades de un club premium.
        </p>
        <div class="divider mx-auto mt-8"></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SERVICIOS — Features grid
         ═══════════════════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 bg-[#131f13]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 reveal">
          <p class="text-gold uppercase tracking-[0.25em] text-xs font-medium mb-3">Vida en el barrio</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold">Todo lo que necesitás</h2>
          <div class="divider mx-auto mt-6"></div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal">
          <div class="text-center p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors">
            <div class="text-4xl mb-4">🛡️</div>
            <h4 class="font-semibold mb-2">Seguridad 24hs</h4>
            <p class="text-sm text-white/40">Portería con control de acceso permanente</p>
          </div>
          <div class="text-center p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors">
            <div class="text-4xl mb-4">🌳</div>
            <h4 class="font-semibold mb-2">Senderos & Naturaleza</h4>
            <p class="text-sm text-white/40">Bicicleta, running y caminatas por el campo</p>
          </div>
          <div class="text-center p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors">
            <div class="text-4xl mb-4">⚽</div>
            <h4 class="font-semibold mb-2">Fútbol</h4>
            <p class="text-sm text-white/40">Cancha de fútbol para partidos del barrio</p>
          </div>
          <div class="text-center p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors">
            <div class="text-4xl mb-4">🏡</div>
            <h4 class="font-semibold mb-2">Chacras</h4>
            <p class="text-sm text-white/40">Lotes amplios con vista al campo</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         UBICACIÓN — Mapa + info
         ═══════════════════════════════════════════════════════════════ -->
    <section id="ubicacion" class="py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 reveal">
          <p class="text-gold uppercase tracking-[0.25em] text-xs font-medium mb-3">Ubicación</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold">A un paso de Buenos Aires</h2>
          <div class="divider mx-auto mt-6"></div>
        </div>

        <!-- Info ubicación -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10 reveal">
          <div class="flex items-start gap-3">
            <span class="text-xl mt-0.5">📍</span>
            <div>
              <h4 class="font-semibold text-sm mb-0.5">San Miguel del Monte</h4>
              <p class="text-xs text-white/50">Buenos Aires, Argentina</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl mt-0.5">🚗</span>
            <div>
              <h4 class="font-semibold text-sm mb-0.5">110 km de CABA</h4>
              <p class="text-xs text-white/50">Autopista Ezeiza y Ruta 3</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl mt-0.5">🌾</span>
            <div>
              <h4 class="font-semibold text-sm mb-0.5">Pampa bonaerense</h4>
              <p class="text-xs text-white/50">Campo, lagunas y tranquilidad</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-xl mt-0.5">🏘️</span>
            <div>
              <h4 class="font-semibold text-sm mb-0.5">Barrio cerrado</h4>
              <p class="text-xs text-white/50">Seguridad 24 horas</p>
            </div>
          </div>
        </div>

        <!-- Mapas: Street View + Satélite lado a lado -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal">
          <!-- Street View (entrada) — arriba en mobile -->
          <div class="order-1 md:order-1">
            <p class="text-center text-white/40 uppercase tracking-[0.2em] text-xs mb-3">Entrada a la estancia</p>
            <div class="rounded-2xl overflow-hidden aspect-[4/3] border border-white/10">
              <iframe
                src="https://www.google.com/maps/embed?pb=!4v1!6m8!1m7!1sstZAH2nLN35U3cpjZ1eYtQ!2m2!1d-35.5736982!2d-58.6401297!3f64.39!4f-0.5!5f1.5"
                class="w-full h-full border-0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
          <!-- Mapa satélite — abajo en mobile -->
          <div class="order-2 md:order-2">
            <p class="text-center text-white/40 uppercase tracking-[0.2em] text-xs mb-3">Vista satelital</p>
            <div class="rounded-2xl overflow-hidden aspect-[4/3] border border-white/10">
              <iframe

---
import '../styles/globals.css';
---

<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Benquerencia Farm Club — El club de chacras mas grande de Argentina con 2150 Ha totales, a 130 km de Capital Federal" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/logo.png" />
<title>Benquerencia Farm Club</title>
<style>
  html { scroll-behavior: smooth; }

  /* Kerning */
  .tracking-luxe { letter-spacing: 0.18em; }
  .tracking-mid { letter-spacing: 0.06em; }

  /* Animaciones */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes ruleGrow {
    from { width: 0; opacity: 0; }
    to { width: 96px; opacity: 1; }
  }
  .anim-fade-up { animation: fadeUp 1.2s cubic-bezier(.2,.7,.2,1) both; }
  .anim-fade-in { animation: fadeIn 1.4s ease-out both; }
  .anim-rule { animation: ruleGrow 1.6s cubic-bezier(.2,.7,.2,1) both; }
  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.6s; }
  .delay-3 { animation-delay: 1.0s; }
  .delay-4 { animation-delay: 1.4s; }
  .delay-5 { animation-delay: 1.8s; }
  .delay-6 { animation-delay: 2.2s; }

  /* Reveal on scroll */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s ease-out, transform .9s cubic-bezier(.2,.7,.2,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* Video cover */
  .yt-cover {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw; height: 56.25vw;
    min-width: 177.77vh; min-height: 100vh;
    pointer-events: none;
  }

  /* Activity cards */
  .activity-card { overflow: hidden; }
  .activity-card .activity-img { transition: transform 900ms cubic-bezier(.2,.7,.2,1); }
  .activity-card:hover .activity-img { transform: scale(1.06); }

  /* Hairline */
  .hairline { height: 1px; background: linear-gradient(90deg, transparent, rgba(199,165,78,0.5), transparent); }

  /* Btn coriander */
  .btn-coriander {
    background: #488A0F; color: white;
    transition: all 400ms cubic-bezier(.2,.7,.2,1);
    letter-spacing: 0.14em;
  }
  .btn-coriander:hover {
    background: #3a7a08;
    box-shadow: 0 18px 40px -12px rgba(72,138,15,0.4);
    transform: translateY(-1px);
  }

  /* Nav link underline */
  .nav-link { position: relative; padding-bottom: 6px; }
  .nav-link::after {
    content: ''; position: absolute; left: 50%; bottom: 0;
    width: 0; height: 2px; background: #C7A54E;
    transform: translateX(-50%);
    transition: width 400ms ease;
  }
  .nav-link:hover::after, .nav-link.active::after { width: 24px; }

  /* Service icon hover */
  .svc-card { transition: transform 400ms ease, box-shadow 400ms ease; }
  .svc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px -8px rgba(0,0,0,0.1); }

  /* Header scroll state */
  .header-scrolled {
    background: rgba(58, 74, 50, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Hero text timed visibility */
  .hero-content {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-content.show { opacity: 1; }
  .hero-content.hide { opacity: 0; }

  /* Scroll arrow bounce */
  @keyframes arrowBounce {
    0%, 100% { transform: translate(-50%, 0); }
    50%       { transform: translate(-50%, 10px); }
  }
  .scroll-arrow {
    animation: arrowBounce 2s ease-in-out infinite;
  }

  /* Mobile menu */
  .mobile-menu {
    max-height: 0; overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    opacity: 0;
  }
  .mobile-menu.open { max-height: 500px; opacity: 1; }

  /* Reglamento cards */
  .reglamento-card {
    transition: transform 400ms ease;
  }
  .reglamento-card:hover { transform: translateY(-2px); }
</style>
</head>
<body class="bg-white text-slate-700 font-sans antialiased">

<!-- ═══════════════════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════════════════ -->
<header class="fixed top-0 inset-x-0 z-50 transition-all duration-500" id="site-header">

  <nav class="max-w-[1400px] mx-auto px-6 md:px-8 h-[68px] flex items-center justify-between text-white relative">

    <!-- Links izquierda (desktop) -->
    <ul class="hidden lg:flex items-center gap-7 text-[12px] tracking-mid font-light">
      <li><a href="#inicio" class="nav-link active text-roti">Inicio</a></li>
      <li><a href="#benquerencia" class="nav-link">Benquerencia</a></li>
      <li><a href="#actividades" class="nav-link">Actividades</a></li>
      <li><a href="#servicios" class="nav-link">Servicios</a></li>
      <li><a href="#senderos" class="nav-link">Senderos</a></li>
    </ul>

    <!-- Logo central -->
    <a href="#inicio" class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-10">
      <div class="w-[52px] h-[52px] rounded-full ring-1 ring-white/40 bg-forestDeep flex items-center justify-center overflow-hidden">
        <img src="/img/logo-benquerencia-verde.png" alt="Estancia Benquerencia" class="w-11 h-11 object-contain" />
      </div>
    </a>

    <!-- Links derecha (desktop) -->
    <ul class="hidden lg:flex items-center gap-5 text-[12px] tracking-mid font-light">
      <li><a href="#ubicacion" class="nav-link">Ubicacion</a></li>
      <li><a href="#contacto" class="nav-link">Contacto</a></li>
      <!-- Instagram -->
      <li>
        <a href="https://www.instagram.com/benquerencia_oficial/" target="_blank" rel="noopener"
           class="flex items-center gap-1.5 hover:text-roti transition-colors">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
        </a>
      </li>
      <!-- Facebook -->
      <li>
        <a href="https://www.facebook.com/benquerenciafc" target="_blank" rel="noopener"
           class="flex items-center gap-1.5 hover:text-roti transition-colors">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </li>
      <!-- Supply CTA -->
      <li class="pl-4 ml-1 border-l border-white/20">
        <a href="https://www.simplesolutions.com.ar/benque/" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 px-4 py-1.5 text-[11px] uppercase tracking-luxe font-medium rounded-sm border border-roti/60 text-roti hover:bg-roti hover:text-forestDeep transition-all duration-300">
          Propietarios
        </a>
      </li>
    </ul>

    <!-- Hamburger (mobile) -->
    <button class="lg:hidden ml-auto text-white z-10" id="menu-toggle" aria-label="Menu">
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="1.5" d="M6 6l12 12M6 18L18 6"/></svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div class="mobile-menu lg:hidden bg-forestDeep/97 backdrop-blur-md border-t border-white/10" id="mobile-menu">
    <div class="px-6 py-5 space-y-1 text-[14px] font-light text-white/90">
      <a href="#inicio" class="block py-2 text-roti border-b border-white/5">Inicio</a>
      <a href="#benquerencia" class="block py-2 border-b border-white/5">Benquerencia</a>
      <a href="#actividades" class="block py-2 border-b border-white/5">Actividades</a>
      <a href="#servicios" class="block py-2 border-b border-white/5">Servicios</a>
      <a href="#senderos" class="block py-2 border-b border-white/5">Senderos</a>
      <a href="#ubicacion" class="block py-2 border-b border-white/5">Ubicacion</a>
      <a href="#contacto" class="block py-2 border-b border-white/5">Contacto</a>
      <!-- Social + Supply -->
      <div class="pt-4 flex items-center gap-5 text-white/70">
        <a href="https://www.instagram.com/benquerencia_oficial/" target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-roti transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
          Instagram
        </a>
        <a href="https://www.facebook.com/benquerenciafc" target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-roti transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          Facebook
        </a>
      </div>
      <div class="pt-3 flex items-center justify-between gap-3">
        <a href="https://www.simplesolutions.com.ar/benque/" target="_blank" rel="noopener"
           class="flex-1 text-center py-2.5 text-[12px] uppercase tracking-luxe font-medium border border-roti/60 text-roti rounded-sm hover:bg-roti hover:text-forestDeep transition-all duration-300">
          Propietarios
        </a>
      </div>
    </div>
  </div>
</header>

<!-- ═══════════════════════════════════════════════════════════════
     1) HERO — Video local de fondo
     ═══════════════════════════════════════════════════════════════ -->
<section id="inicio" class="relative min-h-screen w-full overflow-hidden bg-forestDeep">

  <!-- Video local -->
  <div class="absolute inset-0 z-0">
    <video
      class="yt-cover"
      autoplay muted loop playsinline preload="auto"
      style="object-fit:cover; width:100%; height:100%; position:absolute; top:0; left:0; transform:none; min-width:0; min-height:0;">
      <source src="/video/benquerencia.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Overlay oscuro -->
  <div class="absolute inset-0 z-10 bg-black/50"></div>

  <!-- Gradiente top -->
  <div class="absolute inset-x-0 top-0 h-32 z-10 bg-gradient-to-b from-forest/60 to-transparent"></div>

  <!-- Contenido hero -->
  <div class="relative z-20 min-h-screen flex flex-col items-center justify-center px-6 md:px-8 text-center text-white">

    <div class="hero-content" id="hero-text">
      <div class="uppercase text-[11px] tracking-luxe font-light text-roti">
        Estancia &middot; San Miguel del Monte &middot; Buenos Aires
      </div>

      <div class="mt-7 mb-9 h-px bg-roti anim-rule"></div>

      <h1 class="font-serif font-light text-white leading-[1.05] tracking-wide
                 text-5xl md:text-7xl lg:text-[7.5rem] max-w-[18ch]">
        Benquerencia<br/>
        <span class="italic font-light text-white/95">Farm Club</span>
      </h1>

      <p class="mt-10 max-w-2xl mx-auto text-[14px] md:text-base font-light leading-relaxed text-white/85">
        El club de chacras mas grande de Argentina con 2150 Ha totales,
        450 Ha de espacios comunes y 25 km de senderos.
        Un verdadero paraiso a 130 km de Capital Federal.
      </p>
    </div>

    <!-- Flecha scroll -->
    <a href="#benquerencia" class="absolute bottom-6 left-1/2 -translate-x-1/2 scroll-arrow text-white/70 hover:text-white transition-colors">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <polyline points="8,13 18,24 28,13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     2) BENQUERENCIA — Quienes somos
     ═══════════════════════════════════════════════════════════════ -->
<section id="benquerencia" class="relative bg-white py-24 md:py-36 overflow-hidden">
  <div class="max-w-3xl mx-auto px-6 md:px-8 text-center reveal">
    <div class="flex justify-center mb-12">
      <img src="/img/logo-barrio.png" alt="Benquerencia Farm Club" class="w-28 h-28 object-contain" />
    </div>

    <h2 class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide mb-10">
      Benquerencia Farm Club
    </h2>

    <p class="text-[16px] md:text-[19px] font-light leading-[1.85] text-slate-700 max-w-2xl mx-auto">
      Es el club de chacras mas grande de Argentina con
      <span class="text-coriander font-medium">2150 Ha totales</span>,
      <span class="text-coriander font-medium">450 Ha</span> de espacios comunes,
      <span class="text-coriander font-medium">20 Ha</span> de parques del Casco Principal
      diseñado por el legendario paisajista
      <span class="italic">Carlos Thays</span> y
      <span class="text-coriander font-medium">25 km</span> de senderos para recorrer
      a caballo, en bicicleta o a pie.
      Un verdadero paraiso a 130 km de Capital Federal.
    </p>

    <div class="mt-16 mx-auto w-16 h-px bg-roti"></div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     2b) HISTORIA
     ═══════════════════════════════════════════════════════════════ -->
<section id="historia" class="relative bg-cream/40 py-20 md:py-28 overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8">

    <!-- Header image -->
    <div class="reveal mb-16 rounded-sm overflow-hidden">
      <img src="/img/historia/header.jpg" alt="Estancia Benquerencia" class="w-full h-[300px] md:h-[440px] object-cover" />
    </div>

    <div class="text-center mb-16 md:mb-20 reveal">
      <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">Una Estancia con mucha historia</p>
      <h2 class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide">
        Doscientos cuarenta años<br class="hidden md:block"/>de tradicion pampeana
      </h2>
      <div class="mt-8 mx-auto w-12 h-px bg-roti"></div>
    </div>

    <div class="relative">
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-roti/30 to-transparent"></div>

      <div class="space-y-16 md:space-y-20">

        <!-- 1780 -->
        <div class="reveal grid md:grid-cols-2 gap-8 md:gap-20 items-center">
          <div class="md:text-right md:pr-12">
            <div class="font-serif text-coriander text-6xl md:text-8xl font-light leading-none">1780</div>
            <div class="mt-2 uppercase text-[11px] tracking-luxe text-slate-500">Origenes coloniales</div>
          </div>
          <div class="md:pl-12 relative">
            <div class="hidden md:block absolute -left-[7px] top-3 w-3 h-3 rounded-full bg-coriander ring-4 ring-white"></div>
            <p class="text-[15px] leading-[1.85] text-slate-600 font-light max-w-md">
              Ocho familias fundadoras llegaron en carreta en mayo de 1780 a las cercanias
              del Fortin Guardia del Monte, fundando San Miguel del Monte. Los origenes de
              la estancia se remontan a este periodo colonial.
            </p>
          </div>
        </div>

        <!-- Videla -->
        <div class="reveal grid md:grid-cols-2 gap-8 md:gap-20 items-center">
          <div class="md:order-2 md:pl-12">
            <div class="font-serif text-coriander text-6xl md:text-8xl font-light leading-none">1835</div>
            <div class="mt-2 uppercase text-[11px] tracking-luxe text-slate-500">Jose Zenon Videla</div>
          </div>
          <div class="md:order-1 md:text-right md:pr-12 relative">
            <div class="hidden md:block absolute -right-[7px] top-3 w-3 h-3 rounded-full bg-coriander ring-4 ring-white"></div>
            <p class="text-[15px] leading-[1.85] text-slate-600 font-light max-w-md md:ml-auto">
              Jose Zenon Videla, descendiente de colonos fronterizos, heredo aproximadamente
              <span class="text-coriander font-medium">250.000 hectareas</span> que conformaban
              la Estancia El Rosario. Su oposicion a Juan Manuel de Rosas resulto en la
              expropiacion de sus tierras en 1835.
            </p>
          </div>
        </div>

        <!-- Historia image -->
        <div class="reveal">
          <img src="/img/historia/historia2.jpg" alt="Historia de Benquerencia" class="w-full h-[260px] md:h-[380px] object-cover rounded-sm" />
        </div>

        <!-- Thays -->
        <div class="reveal">
          <div class="bg-cream rounded-sm px-6 md:px-20 py-12 md:py-20 relative">
            <div class="grid md:grid-cols-12 gap-8 items-start">
              <div class="md:col-span-4">
                <p class="uppercase text-[11px] tracking-luxe text-coriander mb-3">Diseño paisajistico</p>
                <h3 class="font-serif text-4xl md:text-5xl font-light text-slate-800 leading-[1.1]">
                  Charles<br/>Thays
                </h3>
                <div class="mt-4 w-10 h-px bg-roti"></div>
                <p class="mt-4 text-[12px] uppercase tracking-mid text-slate-500">1849 — 1934</p>
              </div>
              <div class="md:col-span-8 md:pl-8 md:border-l md:border-roti/30">
                <p class="text-[15px] md:text-[16px] leading-[1.9] text-slate-700 font-light">
                  Ramon Videla Dorna fundo la Estancia San Pascual, encargando a Charles Thays
                  — director de Parques y Paseos Publicos de Buenos Aires — el diseño paisajistico.
                  Thays, autor del Jardin Botanico de Buenos Aires y del Parque San Martin de Mendoza,
                  concibio y ejecuto el diseño monumental de los parques del Casco Principal.
                </p>
                <div class="mt-8 flex items-center gap-6">
                  <div>
                    <div class="font-serif text-3xl text-coriander font-light">20<span class="text-xl"> ha</span></div>
                    <div class="text-[11px] uppercase tracking-mid text-slate-500 mt-1">Parques del casco</div>
                  </div>
                  <div class="w-px h-10 bg-roti/30"></div>
                  <div>
                    <div class="font-serif text-3xl text-coriander font-light">450<span class="text-xl"> ha</span></div>
                    <div class="text-[11px] uppercase tracking-mid text-slate-500 mt-1">Espacios comunes</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 1938 Staudt -->
        <div class="reveal grid md:grid-cols-2 gap-8 md:gap-20 items-center">
          <div class="md:text-right md:pr-12">
            <div class="font-serif text-coriander text-6xl md:text-8xl font-light leading-none">1938</div>
            <div class="mt-2 uppercase text-[11px] tracking-luxe text-slate-500">Ricardo Staudt</div>
          </div>
          <div class="md:pl-12 relative">
            <div class="hidden md:block absolute -left-[7px] top-3 w-3 h-3 rounded-full bg-coriander ring-4 ring-white"></div>
            <p class="text-[15px] leading-[1.85] text-slate-600 font-light max-w-md">
              Ricardo Staudt adquirio la propiedad, renombrandola Benquerencia.
              Acomtio la renovacion arquitectonica con especialistas en estilo colonial,
              incorporo los celebres azulejos europeos y planto 20 km de avenidas con
              casuarinas, alamos y robles. Establecio la Cabaña Benquerencia para la cria
              de ganado Hereford, inscripta en la Sociedad Rural Argentina en 1940.
            </p>
          </div>
        </div>

        <!-- Historia image 2 -->
        <div class="reveal">
          <img src="/img/historia/historia3.jpg" alt="Casco de Benquerencia" class="w-full h-[260px] md:h-[400px] object-cover rounded-sm" />
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     3) ACTIVIDADES
     ═══════════════════════════════════════════════════════════════ -->
<section id="actividades" class="relative bg-white py-20 md:py-28">
  <div class="max-w-[1400px] mx-auto px-6 md:px-8">

    <div class="text-center mb-14 reveal">
      <p class="uppercase text-[11px] tracking-luxe text-roti mb-4">Actividades</p>
      <h2 class="font-serif font-light text-slate-800 text-4xl md:text-5xl lg:text-6xl tracking-wide">
        Naturaleza, desafios deportivos<br class="hidden md:block"/> y buenos momentos
      </h2>
      <div class="mt-8 mx-auto w-12 h-px bg-roti"></div>
      <p class="mt-8 max-w-2xl mx-auto text-[15px] font-light leading-relaxed text-slate-600">
        Benquerencia Farm Club es un lugar ideal para el relax y el descanso,
        y tambien es un lugar ideal para la practica de actividades deportivas
        y recreativas en pleno contacto con la naturaleza.
      </p>
    </div>

    <!-- Grid de actividades con imagenes del sitio WP -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 reveal">

      <!-- POLO -->
      <a href="#polo" class="activity-card group relative aspect-[3/4] md:aspect-[3/5] block rounded-sm">
        <img src="/img/actividades/polo.jpg" alt="Polo" class="activity-img absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/60 group-hover:to-black/70 transition-all duration-500"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
          <div class="w-10 h-px bg-white/80 mb-6"></div>
          <h3 class="font-serif font-light text-2xl md:text-3xl lg:text-4xl tracking-wide">Polo</h3>
          <span class="mt-3 text-[10px] uppercase tracking-luxe text-white/70 opacity-0 group-hover:opacity-100 transition-opacity">8 canchas</span>
        </div>
      </a>

      <!-- TENIS -->
      <a href="#tenis" class="activity-card group relative aspect-[3/4] md:aspect-[3/5] block rounded-sm">
        <img src="/img/actividades/tenis.jpg" alt="Tenis" class="activity-img absolute inset-0 w-full h-full object-cover" />

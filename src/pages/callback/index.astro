---
// Página de callback OAuth para MercadoLibre.
// MercadoLibre redirige aquí con ?code=XXXX después de que el usuario autoriza.
// El script cliente muestra el código al guardia para pegarlo en la app.
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Autorización MercadoLibre">
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

      <!-- Card principal -->
      <div class="rounded-xl border border-ben-700 bg-ben-800 shadow-xl p-8 text-center space-y-6">

        <!-- Logo -->
        <img
          src="/logo.png"
          alt="Logo"
          class="w-20 h-20 rounded-full mx-auto ring-4 ring-ben-600/30"
        />

        <!-- Título y badge — se actualizan por JS -->
        <div class="space-y-2">
          <h1 class="text-xl font-bold" id="titulo">Procesando autorización…</h1>
          <div id="badge-container"></div>
        </div>

        <!-- Contenido dinámico -->
        <div id="contenido" class="space-y-4 text-left"></div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const params   = new URLSearchParams(window.location.search);
  const code     = params.get('code');
  const error    = params.get('error');
  const errDesc  = params.get('error_description');

  const titulo   = document.getElementById('titulo')!;
  const badge    = document.getElementById('badge-container')!;
  const contenido = document.getElementById('contenido')!;

  /* ── Autorización exitosa ── */
  if (code) {
    titulo.textContent = '¡Autorización exitosa!';

    badge.innerHTML = `
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full
                   bg-emerald-600/20 text-emerald-400 border border-emerald-600/40">
        ✅ Conectado con MercadoLibre
      </span>`;

    contenido.innerHTML = `
      <!-- Pasos -->
      <div class="space-y-2">
        <div class="flex gap-3 items-start rounded-lg bg-ben-900/60 border border-ben-700 p-3">
          <span class="w-6 h-6 min-w-6 rounded-full bg-ben-600 text-white
                       text-xs font-bold flex items-center justify-center">1</span>
          <p class="text-sm text-ben-400">
            Hacé clic en <strong class="text-white">Copiar código</strong> o tocá el recuadro verde
          </p>
        </div>
        <div class="flex gap-3 items-start rounded-lg bg-ben-900/60 border border-ben-700 p-3">
          <span class="w-6 h-6 min-w-6 rounded-full bg-ben-600 text-white
                       text-xs font-bold flex items-center justify-center">2</span>
          <p class="text-sm text-ben-400">
            Volvé a la <strong class="text-white">app de portería</strong> y pegá el código donde te lo pide
          </p>
        </div>
      </div>

      <!-- Código -->
      <div>
        <p class="text-xs text-ben-400 mb-1.5">Código de autorización</p>
        <div
          id="codeBox"
          onclick="copiar()"
          title="Clic para copiar"
          class="rounded-lg border-2 border-ben-600/60 hover:border-ben-400 bg-ben-900
                 p-3 font-mono text-sm text-ben-300 break-all cursor-pointer
                 transition-colors select-all"
        >${code}</div>
      </div>

      <!-- Botón -->
      <button
        id="btnCopy"
        onclick="copiar()"
        class="w-full flex items-center justify-center gap-2 rounded-lg bg-ben-600
               text-white hover:bg-ben-500 transition-colors
               font-semibold py-3 text-sm"
      >
        <span id="btnIcon">📋</span>
        <span id="btnLabel">Copiar código</span>
      </button>

      <p class="text-xs text-ben-400 text-center pt-1">
        Podés cerrar esta ventana después de copiar.
      </p>`;

    /* Auto-copiar al cargar */
    setTimeout(copiar, 400);
  }

  /* ── Error ── */
  else if (error) {
    titulo.textContent = 'Error de autorización';

    badge.innerHTML = `
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full
                   bg-red-600/20 text-red-400 border border-red-600/40">
        ⚠️ Autorización fallida
      </span>`;

    contenido.innerHTML = `
      <div class="rounded-lg border border-red-800/50 bg-red-950/30 p-4 space-y-2">
        <p class="text-sm font-semibold text-red-400">Código: ${error}</p>
        ${errDesc ? `<p class="text-sm text-red-300/80">${errDesc}</p>` : ''}
      </div>
      <p class="text-sm text-ben-400 text-center">
        Cerrá esta ventana y volvé a intentarlo desde la app.
      </p>`;
  }

  /* ── Sin parámetros (acceso directo) ── */
  else {
    titulo.textContent = 'Punto de retorno OAuth';
    badge.innerHTML = `
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full
                   border border-ben-700 text-ben-400">
        ℹ️ Página técnica
      </span>`;
    contenido.innerHTML = `
      <p class="text-sm text-ben-400 text-center">
        Esta página es usada por la app de portería de Estancia Benquerencia
        para autenticarse con MercadoLibre. Si llegaste aquí por error, podés cerrar esta ventana.
      </p>`;
  }

  /* ── Función copiar al portapapeles ── */
  function copiar() {
    if (!code) return;
    navigator.clipboard.writeText(code)
      .then(mostrarCopiado)
      .catch(() => {
        // Fallback: seleccionar el texto
        const range = document.createRange();
        range.selectNode(document.getElementById('codeBox')!);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
        mostrarCopiado();
      });
  }

  function mostrarCopiado() {
    const btn  = document.getElementById('btnCopy');
    const box  = document.getElementById('codeBox');
    const icon = document.getElementById('btnIcon');
    const lbl  = document.getElementById('btnLabel');
    if (!btn || !box) return;

    btn.classList.replace('bg-ben-600', 'bg-emerald-600');
    btn.classList.replace('hover:bg-ben-500', 'hover:bg-emerald-500');
    if (icon) icon.textContent = '✅';
    if (lbl)  lbl.textContent  = '¡Copiado!';

    setTimeout(() => {
      btn.classList.replace('bg-emerald-600', 'bg-ben-600');
      btn.classList.replace('hover:bg-emerald-500', 'hover:bg-ben-500');
      if (icon) icon.textContent = '📋';
      if (lbl)  lbl.textContent  = 'Copiar código';
    }, 3000);
  }
</script>

---
import '../styles/globals.css';
---

<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Caballos en Benquerencia Farm Club — 25 km de senderos arbolados, boxes, corrales y servicio de ensillada" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="stylesheet" href="/tailwind.css" />
<title>Equitacion — Benquerencia Farm Club</title>
<style>
  html { scroll-behavior: smooth; }
  .tracking-luxe { letter-spacing: 0.18em; }
  .tracking-mid { letter-spacing: 0.06em; }
  video::-webkit-media-controls { display: none !important; }
  video::-webkit-media-controls-enclosure { display: none !important; }
  video::-webkit-media-controls-panel { display: none !important; }
  video::-webkit-media-controls-overlay-play-button { display: none !important; }
  video::-webkit-media-controls-start-playback-button { display: none !important; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ruleGrow { from { width: 0; opacity: 0; } to { width: 96px; opacity: 1; } }
  .anim-fade-up { animation: fadeUp 1.2s cubic-bezier(.2,.7,.2,1) both; }
  .anim-fade-in { animation: fadeIn 1.4s ease-out both; }
  .anim-rule { animation: ruleGrow 1.6s cubic-bezier(.2,.7,.2,1) both; }
  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.6s; }
  .delay-3 { animation-delay: 1.0s; }
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .9s ease-out, transform .9s cubic-bezier(.2,.7,.2,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .yt-cover {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw; height: 56.25vw;
    min-width: 177.77vh; min-height: 100vh;
    pointer-events: none;
  }
  @keyframes arrowBounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 10px); }
  }
  .scroll-arrow { animation: arrowBounce 2s ease-in-out infinite; }
</style>
</head>
<body class="bg-white text-slate-700 font-sans antialiased">

<!-- HERO -->
<section class="relative min-h-screen w-full overflow-hidden bg-forestDeep">
  <div class="absolute inset-0 z-0">
    <video class="yt-cover" autoplay muted loop playsinline preload="auto"
      style="object-fit:cover; width:100%; height:100%; position:absolute; top:0; left:0; transform:none; min-width:0; min-height:0;">
      <source src="/video/polo.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="absolute inset-0 z-10 bg-black/50"></div>
  <div class="absolute inset-x-0 top-0 h-32 z-10 bg-gradient-to-b from-forest/60 to-transparent"></div>

  <div class="relative z-20 min-h-screen flex flex-col items-center justify-center px-6 md:px-8 text-center text-white">
    <a href="/" class="mb-8 anim-fade-in">
      <img src="/img/logo-benquerencia-verde.png" alt="Logo" class="w-16 h-16 mx-auto opacity-80 hover:opacity-100 transition-opacity" />
    </a>
    <div class="uppercase text-[11px] tracking-luxe font-light text-roti anim-fade-up delay-1">Actividades</div>
    <div class="mt-7 mb-6 h-px bg-roti anim-rule delay-2"></div>
    <h1 class="font-serif font-light text-white leading-[1.05] tracking-wide text-5xl md:text-7xl lg:text-[7.5rem] anim-fade-up delay-2">
      Equitacion
    </h1>
    <p class="mt-8 max-w-xl mx-auto text-[14px] md:text-base font-light leading-relaxed text-white/85 anim-fade-up delay-3">
      Un tema central en el diseño de Benquerencia Farm Club
    </p>

    <a href="#contenido" class="absolute bottom-6 left-1/2 -translate-x-1/2 scroll-arrow text-white/70 hover:text-white transition-colors">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none"><polyline points="8,13 18,24 28,13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<!-- CONTENIDO -->
<section id="contenido" class="py-20 md:py-28">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8">

    <div class="reveal grid md:grid-cols-2 gap-10 items-center mb-20">
      <div class="rounded-sm overflow-hidden">
        <img src="/img/actividades/caballos-full.jpg" alt="Caballos en Benquerencia" class="w-full h-[300px] md:h-[420px] object-cover" />
      </div>
      <div>
        <p class="uppercase text-[11px] tracking-luxe text-coriander mb-3">Caballos</p>
        <h2 class="font-serif font-light text-slate-800 text-3xl md:text-4xl tracking-wide mb-6">
          Un tema central en Benquerencia
        </h2>
        <p class="text-[15px] leading-[1.85] text-slate-600 font-light mb-4">
          El caballo es un tema central en el diseño de Benquerencia Farm Club.
          Las cabalgatas van desde salidas breves hasta tardes completas recorriendo
          los 25 km de senderos arbolados de uso exclusivo ecuestre.
        </p>
        <p class="text-[15px] leading-[1.85] text-slate-600 font-light">
          Cuenta con dos pistas de equitacion totalmente alambradas en el casco,
          boxes, corrales, paddocks, palenques y servicio de ensillada por personal
          especializado. Areas de pastoreo comun para caballos de propietarios.
        </p>
      </div>
    </div>

    <!-- Stats -->
    <div class="reveal grid grid-cols-2 md:grid-cols-4 gap-6 mb-20">
      <div class="text-center p-6 bg-cream/40 rounded-sm">
        <div class="font-serif text-4xl text-coriander font-light">25 km</div>
        <div class="text-[12px] uppercase tracking-luxe text-slate-500 mt-2">Senderos arbolados</div>
      </div>
      <div class="text-center p-6 bg-cream/40 rounded-sm">
        <div class="font-serif text-4xl text-coriander font-light">2</div>
        <div class="text-[12px] uppercase tracking-luxe text-slate-500 mt-2">Pistas de equitacion</div>
      </div>
      <div class="text-center p-6 bg-cream/40 rounded-sm">
        <div class="font-serif text-4xl text-coriander font-light">Si</div>
        <div class="text-[12px] uppercase tracking-luxe text-slate-500 mt-2">Servicio de ensillada</div>
      </div>
      <div class="text-center p-6 bg-cream/40 rounded-sm">
        <div class="font-serif text-4xl text-coriander font-light">Si</div>
        <div class="text-[12px] uppercase tracking-luxe text-slate-500 mt-2">Pastoreo comun</div>
      </div>
    </div>

    <!-- Details -->
    <div class="reveal bg-cream rounded-sm px-6 md:px-16 py-12 md:py-16">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <p class="uppercase text-[11px] tracking-luxe text-coriander mb-3">Instalaciones</p>
          <h3 class="font-serif font-light text-slate-800 text-2xl md:text-3xl tracking-wide mb-6">Infraestructura ecuestre</h3>
          <ul class="space-y-3 text-[15px] leading-[1.85] text-slate-600 font-light">
            <li class="flex items-start gap-3">
              <span class="text-coriander mt-1">&#9679;</span>
              Dos pistas de equitacion totalmente alambradas
            </li>
            <li class="flex items-start gap-3">
              <span class="text-coriander mt-1">&#9679;</span>
              Boxes, corrales y paddocks
            </li>
            <li class="flex items-start gap-3">
              <span class="text-coriander mt-1">&#9679;</span>
              Palenques y monturas
            </li>
            <li class="flex items-start gap-3">
              <span class="text-coriander mt-1">&#9679;</span>
              Servicio de ensillada por personal especializado
            </li>
            <li class="flex items-start gap-3">
              <span class="text-coriander mt-1">&#9679;</span>
              Areas de pastoreo comun para caballos de propietarios
            </li>
          </ul>
        </div>
        <div>
          <p class="uppercase text-[11px] tracking-luxe text-coriander mb-3">Senderos</p>
          <h3 class="font-serif font-light text-slate-800 text-2xl md:text-3xl tracking-wide mb-6">25 km de recorridos</h3>
          <p class="text-[15px] leading-[1.85] text-slate-600 font-light mb-4">
            Veinticinco kilometros ininterrumpidos de senderos arbolados de uso exclusivo
            ecuestre. Recorridos que van desde paseos breves hasta tardes completas,
            atravesando los paisajes mas pintorescos de la estancia.
          </p>
          <p class="text-[15px] leading-[1.85] text-slate-600 font-light">
            La vegetacion es variada: algunos senderos tienen sombra todo el año gracias
            a perennes, mientras que otros permiten el sol invernal con arboles caducos.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Back link -->
<section class="pb-20">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <div class="h-px w-16 bg-roti mx-auto mb-8"></div>
    <a href="/#actividades" class="inline-flex items-center gap-2 text-slate-500 hover:text-coriander transition-colors text-[13px] uppercase tracking-luxe">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/></svg>
      Volver al inicio
    </a>
  </div>
</section>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

</body>
</html>
